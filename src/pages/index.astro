---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Home from "../components/home.astro";
import Tech from "../components/tech.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Footer from "../components/footer.astro";
import Career from "../components/career.astro";
import localData from "../data/home.json";

interface Social {
    name: string;
    url: string;
    icon: string;
    showInContact: boolean;
}

interface ProfileData {
    name: string;
    webpageTitle: string;
    description?: string;
    jobTitle?: string;
    siteUrl?: string;
    lang?: string;
    socials: Social[];
}

let data = localData as ProfileData;

const { name, webpageTitle, description, jobTitle, siteUrl, lang, socials } =
    data;
---

<Layout
    title={webpageTitle}
    personName={name}
    description={description}
    jobTitle={jobTitle}
    siteUrl={siteUrl}
    lang={lang}
    socials={socials}
>
    <Nav />
    <Home />
    <Career />
    <Projects />
    <Tech />
    <Contact />
    <Footer />
</Layout>
